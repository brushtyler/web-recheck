{
  "name": "web-recheck",
  "version": "1.0.0",
  "description": "Generic, declarative automated UI testing framework with trustworthy release gate",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "web-recheck": "bin/web-recheck.ts"
  },
  "scripts": {
    "cli": "tsx bin/web-recheck.ts",
    "lint": "eslint src bin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "schemas": "tsx scripts/gen-schemas.ts",
    "postinstall:browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.65.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
